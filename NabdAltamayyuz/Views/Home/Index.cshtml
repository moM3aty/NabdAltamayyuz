@using System.Globalization
@{
    ViewData["Title"] = "الرئيسية";
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<!-- Hero Section -->
<div class="hero-wrapper" style="background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1920&auto=format&fit=crop');">
    <div class="hero-overlay"></div>
    <div class="container hero-content text-center">
        <!-- شارة مزود الخدمة المعتمد -->
        <div class="animate-up mb-3">
            <span class="badge bg-gold text-dark border border-white px-4 py-2 rounded-pill fs-6 shadow-lg">
                <i class="fas fa-certificate me-2"></i> @(isRtl ? "مزود خدمة عمل عن بعد معتمد" : "Certified Remote Work Service Provider")
            </span>
        </div>

        <h1 class="display-3 fw-bolder mb-4 animate-up">
            @(isRtl ? "شريككم الاستراتيجي في" : "Your Strategic Partner in")
            <br />
            <span class="text-gradient-gold">@(isRtl ? "الإدارة والتشغيل الاحترافي" : "Professional Management & Operation")</span>
        </h1>
        <p class="lead mb-5 text-light opacity-75 animate-up delay-100 fs-5">
            @(isRtl ? "نصيغ الحلول الإدارية المتكاملة، لتمكين شركتكم من التركيز على أهدافها الكبرى. ندير منصاتكم الحكومية بدقة واحترافية." : "We craft integrated administrative solutions to empower your company to focus on its major goals.")
        </p>
        <div class="d-flex justify-content-center gap-3 animate-up delay-200 flex-wrap">
            <a href="#services" class="btn btn-premium btn-lg">@(isRtl ? "اكتشف خدماتنا" : "Discover Services")</a>
            <a href="https://wa.me/966562056821" class="btn btn-outline-premium btn-lg">@(isRtl ? "احصل على استشارة مجانية" : "Get Free Consultation")</a>
        </div>
    </div>
</div>

<!-- 1. Remote Work Section (العمل عن بعد كما هو) -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 animate-up">
                <img src="~/images/sec.png" class="img-fluid rounded-4 shadow-lg" alt="العمل عن بعد">
            </div>
            <div class="col-lg-6 ps-lg-5 animate-up delay-100">
                <h6 class="text-gold text-uppercase fw-bold letter-spacing-2">@(isRtl ? "خدمات العمل عن بعد" : "Remote Work Services")</h6>
                <h2 class="display-6 fw-bold mb-4 text-dark">@(isRtl ? "منظومة عمل مرنة ومتوافقة" : "Flexible and Compliant Work System")</h2>
                <p class="lead text-secondary mb-4" style="line-height: 1.8;">
                    @(isRtl ? "مزود خدمة معتمد لتقديم حلول العمل عن بعد، نقدم خدمات متكاملة لإدارة وتشغيل الكوادر الوطنية عن بعد عبر المنصة الرسمية، مع ضمان الامتثال الكامل لضوابط وزارة الموارد البشرية، مما يتيح للمنشآت التوسع بمرونة وتكلفة تشغيلية مدروسة." : "Certified remote work solutions provider. We offer integrated services to manage and operate national cadres remotely via the official platform, ensuring full compliance with HRSD regulations, allowing facilities to expand flexibly with calculated operational costs.")
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 2. Services Summary (خدماتنا - الصورة على اليمين للتنسيق) -->
<section id="services" class="section-padding bg-white position-relative overflow-hidden">
    <div class="container position-relative z-1">
        <!-- استخدام flex-row-reverse لعكس الترتيب بحيث تظهر الصورة على اليمين في الواجهة العربية -->
        <div class="row align-items-center @(isRtl ? "flex-lg-row-reverse" : "")">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <img src="~/images/22.jpg" class="img-fluid img-overlap w-100 shadow-lg" alt="Services">
            </div>
            <div class="col-lg-6 @(isRtl ? "pe-lg-5" : "ps-lg-5")">
                <h6 class="text-gold fw-bold text-uppercase">@(isRtl ? "خدماتنا" : "Our Services")</h6>
                <h2 class="display-5 fw-bold mb-4 text-dark">@(isRtl ? "نحن نبني منظومة نجاحكم" : "We Build Your Success System")</h2>

                <ul class="list-unstyled mt-4">
                    <li class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <div class="bg-dark text-gold rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fas fa-check"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="text-secondary mb-0 fw-bold">@(isRtl ? "إدارة شاملة لمنصات الخدمات الحكومية للشركات والمؤسسات." : "Comprehensive management of government service platforms for companies.")</p>
                        </div>
                    </li>
                    <li class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <div class="bg-dark text-gold rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fas fa-check"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="text-secondary mb-0 fw-bold">@(isRtl ? "إعادة تأهيل وهيكلة العمليات الإدارية والمالية لرفع كفاءة المنشأة." : "Restructuring admin and financial operations to increase facility efficiency.")</p>
                        </div>
                    </li>
                    <li class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <div class="bg-dark text-gold rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fas fa-check"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="text-secondary mb-0 fw-bold">@(isRtl ? "دعم إداري يضمن سير العمل دون انقطاع." : "Administrative support ensuring uninterrupted workflow.")</p>
                        </div>
                    </li>
                </ul>

                <div class="alert alert-light border-gold border-start border-4 bg-white shadow-sm mt-4">
                    <p class="mb-0 text-dark fst-italic">"@(isRtl ? "نحن لا ندير معاملاتكم فحسب، نحن نبني منظومة نجاحكم." : "We don't just manage your transactions, we build your success system.")"</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. Why Us Section (لماذا نحن) -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-gold text-uppercase fw-bold letter-spacing-2">@(isRtl ? "لماذا نحن؟" : "WHY US")</h6>
            <h2 class="display-5 fw-bold mb-3 text-dark">@(isRtl ? "قيمنا تضمن نجاحك" : "Our Values Ensure Success")</h2>
            <div class="mx-auto bg-gold" style="width: 80px; height: 4px; border-radius: 2px;"></div>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="card-premium p-4 text-center bg-white">
                    <div class="icon-box-lg mx-auto">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">@(isRtl ? "الدقة المتناهية" : "Absolute Accuracy")</h4>
                    <p class="text-secondary small mb-0">@(isRtl ? "ندرك أن التفاصيل الإدارية هي محرك النمو." : "We realize administrative details drive growth.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card-premium p-4 text-center bg-white">
                    <div class="icon-box-lg mx-auto">
                        <i class="fas fa-laptop-house"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">@(isRtl ? "خبرة المنصات" : "Platforms Expertise")</h4>
                    <p class="text-secondary small mb-0">@(isRtl ? "ندير حساباتكم في (قوى، التأمينات، مكتب العمل) لضمان الانسيابية." : "We manage your accounts in government platforms to ensure workflow smoothness.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card-premium p-4 text-center bg-white">
                    <div class="icon-box-lg mx-auto">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">@(isRtl ? "التفرغ للإبداع" : "Focus on Creativity")</h4>
                    <p class="text-secondary small mb-0">@(isRtl ? "نحن نهتم بالأوراق والعمليات الإدارية، لنترك لك مساحة الابتكار." : "We handle routine paperwork, leaving you space for innovation.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card-premium p-4 text-center bg-white">
                    <div class="icon-box-lg mx-auto">
                        <i class="fas fa-coins"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">@(isRtl ? "توفير التكاليف" : "Cost Saving")</h4>
                    <p class="text-secondary small mb-0">@(isRtl ? "توفير تكاليف التوظيف العالية عبر إسناد المهام الإدارية لخبرائنا." : "Saving high recruitment costs by outsourcing to our experts.")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Clients Section -->
<section class="section-padding bg-white overflow-hidden">
    <div class="container-fluid">
        <div class="text-center mb-5">
            <h5 class="text-dark fw-bold">@(isRtl ? "عملاء وضعوا ثقتهم بنا" : "Clients Who Trusted Us")</h5>
            <div class="mx-auto bg-gold mt-2" style="width: 50px; height: 3px;"></div>
        </div>

        <div class="clients-slider">
            <div class="slide-track">
                @for (int j = 0; j < 2; j++)
                {
                    @for (int i = 1; i <= 8; i++)
                    {
                        <div class="slide">
                            <div class="client-logo-wrapper">
                                <img src="~/images/@(i).jpg" class="img-fluid grayscale-hover" alt="Client @i" onerror="this.src='https://via.placeholder.com/150x80?text=Client+@i'">
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- Contact CTA -->
<section class="py-5 bg-dark text-white text-center position-relative overflow-hidden" style="background: linear-gradient(rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.8)), url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1920&auto=format&fit=crop'); background-size: cover; background-attachment: fixed;">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-20"></div>
    <div class="container position-relative z-1 py-4">
        <h2 class="display-5 fw-bold mb-4">@(isRtl ? "جاهز لبدء رحلة النجاح؟" : "Ready to Start?")</h2>
        <p class="lead text-white-50 mb-5">@(isRtl ? "تواصل معنا اليوم للحصول على استشارة مجانية وتحليل لاحتياجات منشأتك." : "Contact us today for a free consultation and analysis of your facility's needs.")</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="tel:0562056821" class="btn btn-premium btn-lg">
                <i class="fas fa-phone-alt me-2"></i> 0562056821
            </a>
            <a href="https://wa.me/966562056821" style="padding: 10px 25px;" class="btn btn-outline-light btn-lg rounded-pill">
                <i class="fab fa-whatsapp me-2"></i> WhatsApp
            </a>
        </div>
    </div>
</section>