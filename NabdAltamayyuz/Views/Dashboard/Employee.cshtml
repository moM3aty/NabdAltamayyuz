@model IEnumerable<NabdAltamayyuz.Models.WorkTask>
@using System.Globalization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject NabdAltamayyuz.Data.ApplicationDbContext _context

@{
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isRtl ? "لوحة الموظف" : "Employee Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isCheckedIn = ViewBag.IsCheckedIn ?? false;
    bool isCheckedOut = ViewBag.IsCheckedOut ?? false;

    // جلب بيانات الموظف والمشروع
    var userId = int.Parse(User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier));
    var employee = _context.Users.Include(u => u.Project).FirstOrDefault(u => u.Id == userId);

    // إحصائيات المهام المفلترة بالشهر
    var taskMonthStr = Context.Request.Query["taskMonth"].ToString();
    var queryTasks = _context.WorkTasks.Where(t => t.AssignedToId == userId);

    if (!string.IsNullOrEmpty(taskMonthStr))
    {
        var parsedDate = DateTime.Parse(taskMonthStr + "-01");
        queryTasks = queryTasks.Where(t => t.DueDate.Year == parsedDate.Year && t.DueDate.Month == parsedDate.Month);
    }

    var filteredTasks = queryTasks.ToList();
    int totalTasks = filteredTasks.Count;
    int completedTasks = filteredTasks.Count(t => t.IsCompleted);
    int pendingTasks = filteredTasks.Count(t => !t.IsCompleted);
    double completionRate = totalTasks > 0 ? Math.Round((double)completedTasks / totalTasks * 100, 1) : 0;

    // جلب طلبات الإجازات السابقة
    var myLeaves = _context.LeaveRequests.Where(l => l.EmployeeId == userId).OrderByDescending(l => l.CreatedAt).ToList();
}

<div class="container py-5 animate-fade-in" style="margin-top: 120px;">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success rounded-3 shadow-sm mb-4">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        </div>
    }

    <!-- Welcome Section (تمت إضافة المشروع وتاريخ التعيين) -->
    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <h2 class="fw-bold text-dark mb-1">
                @(isRtl ? "مرحباً بك،" : "Welcome,") <span class="text-gold">@employee.FullName</span>
            </h2>
            <div class="d-flex gap-3 text-muted small mt-2">
                <span><i class="fas fa-project-diagram text-gold me-1"></i> @(employee.Project?.Name ?? (isRtl ? "مشروع عام" : "General Project"))</span>
                <span><i class="far fa-calendar-check text-gold me-1"></i> @(isRtl ? "تاريخ التعيين:" : "Hire Date:") @(employee.HireDate?.ToString("yyyy-MM-dd") ?? "-")</span>
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="d-inline-flex align-items-center bg-white shadow-sm px-4 py-2 rounded-pill border border-gold">
                <i class="far fa-calendar-alt text-gold me-2"></i>
                <span class="fw-bold text-dark">@DateTime.Now.ToString("dd MMMM yyyy")</span>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Attendance & Quick Leave Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-dark text-white position-relative h-100">
                <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background: url('https://www.transparenttextures.com/patterns/cubes.png');"></div>
                <div class="card-body p-4 p-lg-5 position-relative z-1 text-center d-flex flex-column justify-content-center">
                    <h4 class="fw-bold mb-4 text-gold"><i class="fas fa-fingerprint me-2"></i> @(isRtl ? "تسجيل الحضور والإجازات" : "Attendance & Leaves")</h4>

                    <div class="d-flex justify-content-center gap-3 flex-wrap mb-4">
                        <form action="/Dashboard/CheckIn" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-lg rounded-4 p-3 shadow-lg hover-scale transition-all @(isCheckedIn ? "btn-secondary disabled" : "btn-success")" style="min-width: 140px;" @(isCheckedIn ? "disabled" : "")>
                                <i class="fas fa-sign-in-alt fa-2x mb-2 d-block"></i>
                                <span class="fw-bold">@(isRtl ? "دخول" : "Check In")</span>
                            </button>
                        </form>

                        <form action="/Dashboard/CheckOut" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-lg rounded-4 p-3 shadow-lg hover-scale transition-all @(isCheckedOut || !isCheckedIn ? "btn-secondary disabled" : "btn-danger")" style="min-width: 140px;" @(isCheckedOut || !isCheckedIn ? "disabled" : "")>
                                <i class="fas fa-sign-out-alt fa-2x mb-2 d-block"></i>
                                <span class="fw-bold">@(isRtl ? "خروج" : "Check Out")</span>
                            </button>
                        </form>

                        <!-- Quick Leave (Today) -->
                        <button type="button" class="btn btn-lg btn-outline-light rounded-4 p-3 shadow-lg hover-scale transition-all" style="min-width: 140px;" onclick="openQuickLeave()">
                            <i class="fas fa-calendar-times fa-2x mb-2 d-block text-warning"></i>
                            <span class="fw-bold">@(isRtl ? "إجازة اليوم" : "Today Leave")</span>
                        </button>
                    </div>

                    <button class="btn btn-gold bg-transparent text-gold border-gold rounded-pill px-4 mx-auto" data-bs-toggle="modal" data-bs-target="#leaveModal">
                        <i class="fas fa-file-signature me-2"></i> @(isRtl ? "تقديم طلب إجازة لفترة محددة" : "Submit Leave Request")
                    </button>
                </div>
            </div>
        </div>

        <!-- Task Performance Meter (تعديل: إضافة فلتر الشهر) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 h-100 bg-white overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-chart-pie text-gold me-2"></i> @(isRtl ? "مؤشر الإنجاز" : "Task Completion")</h6>
                    <form method="get" id="taskFilterForm">
                        <input type="month" name="taskMonth" class="form-control form-control-sm text-primary fw-bold" value="@taskMonthStr" onchange="document.getElementById('taskFilterForm').submit()" title="اختر الشهر لتصفية المهام أو اتركه فارغاً للكل" />
                    </form>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="mb-3">
                            <span class="text-muted small">@(isRtl ? "المهام الكلية" : "Total Tasks")</span>
                            <h3 class="fw-bold text-dark">@totalTasks</h3>
                        </div>
                        <div class="d-flex gap-3">
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">@(isRtl ? "منجز" : "Completed") @completedTasks</span>
                            </div>
                            <div>
                                <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill px-3">@(isRtl ? "متبقي" : "Remaining") @pendingTasks</span>
                            </div>
                        </div>
                    </div>
                    <div style="width: 120px; height: 120px;">
                        <svg viewBox="0 0 36 36" class="circular-chart gold">
                            <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="circle" stroke-dasharray="@completionRate, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <text x="18" y="20.35" class="percentage">@completionRate%</text>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- My Leaves Log -->
        <div class="col-lg-12 mb-2">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0 border-start border-5 border-gold ps-3">@(isRtl ? "طلبات الإجازات" : "Leave Requests")</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 250px;">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="bg-light small">
                                <tr>
                                    <th>@(isRtl ? "تاريخ التقديم" : "Date")</th>
                                    <th>@(isRtl ? "نوع الإجازة" : "Type")</th>
                                    <th>@(isRtl ? "من - إلى" : "From - To")</th>
                                    <th>@(isRtl ? "المدة (يوم)" : "Duration")</th>
                                    <th>@(isRtl ? "الحالة" : "Status")</th>
                                    <th>@(isRtl ? "طباعة" : "Print")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (myLeaves.Any())
                                {
                                    foreach (var l in myLeaves)
                                    {
                                        var statusBadge = l.Status == NabdAltamayyuz.Models.LeaveStatus.Approved ? "bg-success" :
                                        (l.Status == NabdAltamayyuz.Models.LeaveStatus.Rejected ? "bg-danger" : "bg-warning text-dark");

                                        // ترجمة نوع الإجازة للغة العربية في العرض
                                        var typeName = l.Type switch
                                        {
                                            NabdAltamayyuz.Models.LeaveType.Annual => "إجازة سنوية",
                                            NabdAltamayyuz.Models.LeaveType.Unpaid => "إجازة بدون أجر",
                                            NabdAltamayyuz.Models.LeaveType.Sick => "إجازة مرضية",
                                            NabdAltamayyuz.Models.LeaveType.Marriage => "إجازة زواج",
                                            NabdAltamayyuz.Models.LeaveType.Maternity => "إجازة مولود",
                                            NabdAltamayyuz.Models.LeaveType.Exams => "إجازة اختبارات",
                                            NabdAltamayyuz.Models.LeaveType.Hajj => "إجازة حج",
                                            NabdAltamayyuz.Models.LeaveType.Death => "إجازة وفاة",
                                            _ => l.CustomTypeName ?? "أخرى"
                                        };

                                        <tr>
                                            <td class="small">@l.CreatedAt.ToString("yyyy-MM-dd")</td>
                                            <td class="fw-bold">@typeName</td>
                                            <td class="font-monospace small text-muted">@l.StartDate.ToString("dd/MM") - @l.EndDate.ToString("dd/MM")</td>
                                            <td><span class="badge bg-dark bg-opacity-10 text-dark">@l.DurationDays</span></td>
                                            <td><span class="badge @statusBadge rounded-pill px-3">@l.Status</span></td>
                                            <td>
                                                <a href="/Leaves/Print/@l.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle" title="طباعة النموذج">
                                                    <i class="fas fa-print"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="py-4 text-muted small">@(isRtl ? "لا توجد طلبات سابقة" : "No leave requests found")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Current Tasks -->
        <div class="col-lg-12">
            <h5 class="fw-bold text-dark border-start border-5 border-gold ps-3 mb-3">@(isRtl ? "المهام المعلقة" : "Pending Tasks")</h5>
            <div class="row g-4">
                @if (filteredTasks.Any(t => !t.IsCompleted))
                {
                    foreach (var task in filteredTasks.Where(t => !t.IsCompleted))
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm h-100 rounded-4 hover-lift task-card bg-white position-relative">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <span class="badge bg-gold text-dark rounded-pill px-3">@(isRtl ? "مهمة" : "Task")</span>
                                        <small class="text-danger fw-bold font-monospace"><i class="far fa-clock me-1"></i> @task.DueDate.ToString("yyyy-MM-dd")</small>
                                    </div>
                                    <h5 class="card-title fw-bold text-dark mb-2 text-truncate" title="@task.Title">@task.Title</h5>
                                    <p class="card-text text-muted small mb-4 line-clamp-2">@task.Description</p>

                                    <hr class="border-secondary opacity-10">

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-dark btn-sm rounded-pill w-100" onclick="completeTaskUI(@task.Id)">
                                            <i class="fas fa-check me-2 text-gold"></i> @(isRtl ? "إنجاز" : "Complete")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 bg-light rounded-4 border border-dashed">
                        <i class="fas fa-check-circle fa-3x text-success mb-3 opacity-50"></i>
                        <h5 class="text-muted fw-bold">@(isRtl ? "لا توجد مهام معلقة" : "No pending tasks")</h5>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="leaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h5 class="modal-title fw-bold text-gold"><i class="fas fa-file-signature me-2"></i> @(isRtl ? "نموذج طلب إجازة" : "Leave Request Form")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Leaves/Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">@(isRtl ? "نوع الإجازة" : "Leave Type")</label>
                        <!-- أنواع الإجازات بالعربي -->
                        <select name="Type" id="leaveTypeSelect" class="form-select bg-light" required onchange="checkCustomType(this.value)">
                            <option value="Annual">إجازة سنوية</option>
                            <option value="Unpaid">إجازة بدون أجر</option>
                            <option value="Sick">إجازة مرضية</option>
                            <option value="Marriage">إجازة زواج</option>
                            <option value="Maternity">إجازة مولود</option>
                            <option value="Exams">إجازة اختبارات</option>
                            <option value="Hajj">إجازة حج</option>
                            <option value="Death">إجازة وفاة</option>
                            <option value="Other">أخرى</option>
                        </select>
                    </div>

                    <div class="mb-3" id="customTypeDiv" style="display: none;">
                        <label class="form-label fw-bold small text-primary">@(isRtl ? "اسم الإجازة (أخرى)" : "Other Leave Name")</label>
                        <input type="text" name="CustomTypeName" class="form-control border-primary" placeholder="@(isRtl ? "حدد نوع الإجازة بدقة" : "Specify type")" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">@(isRtl ? "من تاريخ" : "From Date")</label>
                            <input type="date" name="StartDate" id="leaveStartDate" class="form-control bg-light" required onchange="calculateDuration()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">@(isRtl ? "إلى تاريخ" : "To Date")</label>
                            <input type="date" name="EndDate" id="leaveEndDate" class="form-control bg-light" required onchange="calculateDuration()" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">@(isRtl ? "مدة الإجازة (بالأيام)" : "Duration (Days)")</label>
                        <input type="number" name="DurationDays" id="leaveDuration" class="form-control bg-white fw-bold text-center fs-5 text-primary" readonly required />
                        <span class="form-text small text-muted">يتم حساب المدة تلقائياً بناءً على التواريخ المختارة.</span>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">@(isRtl ? "إلغاء" : "Cancel")</button>
                    <button type="submit" class="btn btn-gold bg-dark text-gold fw-bold rounded-pill px-5 shadow-sm">@(isRtl ? "إرسال الطلب" : "Submit Request")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .circular-chart {
        display: block;
        margin: 0 auto;
        max-width: 100%;
        max-height: 250px;
    }

    .circle-bg {
        fill: none;
        stroke: #eee;
        stroke-width: 3.8;
    }

    .circle {
        fill: none;
        stroke-width: 2.8;
        stroke-linecap: round;
        animation: progress 1s ease-out forwards;
    }

    .percentage {
        fill: #333;
        font-family: sans-serif;
        font-weight: bold;
        font-size: 0.5em;
        text-anchor: middle;
    }

    .circular-chart.gold .circle {
        stroke: #D4AF37;
    }

    @@keyframes progress {
        0% {
            stroke-dasharray: 0 100;
        }
    }
</style>

@section Scripts {
    <script>
        function openQuickLeave() {
            var today = new Date().toISOString().split('T')[0];
            document.getElementById('leaveStartDate').value = today;
            document.getElementById('leaveEndDate').value = today;
            calculateDuration();
            new bootstrap.Modal(document.getElementById('leaveModal')).show();
        }

        function checkCustomType(val) {
            var div = document.getElementById('customTypeDiv');
            if (val === 'Other') div.style.display = 'block';
            else div.style.display = 'none';
        }

        function calculateDuration() {
            var start = document.getElementById('leaveStartDate').value;
            var end = document.getElementById('leaveEndDate').value;

            if (start && end) {
                var d1 = new Date(start);
                var d2 = new Date(end);
                if (d2 >= d1) {
                    var diffTime = Math.abs(d2 - d1);
                    var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1; // +1 to include both start and end days
                    document.getElementById('leaveDuration').value = diffDays;
                } else {
                    document.getElementById('leaveDuration').value = 0;
                }
            }
        }

        function completeTaskUI(id) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            fetch('/Tasks/Complete/' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            })
            .then(res => res.json())
            .then(data => { if (data.success) location.reload(); });
        }
    </script>
}