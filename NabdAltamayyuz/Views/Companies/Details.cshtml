@model NabdAltamayyuz.Models.Company
@using System.Globalization

@{
    ViewData["Title"] = CultureInfo.CurrentCulture.Name.StartsWith("ar") ? "تفاصيل الشركة" : "Company Details";
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<div class="container py-5 animate-fade-in" style="margin-top: 100px;">
    <!-- Header Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/Dashboard/SuperAdmin" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-right me-2 rtl-flip"></i> @(isRtl ? "عودة للوحة التحكم" : "Back to Dashboard")
        </a>
        <div class="d-flex gap-2">
            <a href="/Companies/Edit/@Model.Id" class="btn btn-gold bg-dark text-gold fw-bold rounded-pill px-4 shadow-sm">
                <i class="fas fa-edit me-2"></i> @(isRtl ? "تعديل البيانات" : "Edit Details")
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success rounded-3 mb-4"><i class="fas fa-check-circle me-2"></i> @TempData["Success"]</div>
    }

    <div class="row g-4">
        <!-- Main Info Card -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-start">
                    <div class="d-flex align-items-center">
                        <div class="avatar-circle bg-gold text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                            <i class="fas fa-building"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 text-gold fw-bold">@Model.Name</h4>
                            <p class="mb-0 text-white-50 font-monospace">@Model.RegistrationNumber</p>
                        </div>
                    </div>
                    <span class="badge @(Model.IsSuspended ? "bg-danger" : "bg-success") rounded-pill px-3 py-2">
                        @(Model.IsSuspended ? (isRtl ? "معلق" : "Suspended") : (isRtl ? "نشط" : "Active"))
                    </span>
                </div>
                <div class="card-body p-4 bg-white">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">@(isRtl ? "معلومات الاتصال والمسؤول" : "Contact & Responsible Info")</h6>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-light rounded-circle p-2 me-3"><i class="fas fa-user-tie text-gold"></i></div>
                                <div>
                                    <small class="text-muted d-block">@(isRtl ? "المسؤول" : "Responsible Person")</small>
                                    <span class="fw-bold">@Model.ResponsiblePerson</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-light rounded-circle p-2 me-3"><i class="fas fa-phone text-gold"></i></div>
                                <div>
                                    <small class="text-muted d-block">@(isRtl ? "رقم التواصل" : "Phone")</small>
                                    <span class="fw-bold" dir="ltr">@Model.PhoneNumber</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-light rounded-circle p-2 me-3"><i class="fas fa-envelope text-gold"></i></div>
                                <div>
                                    <small class="text-muted d-block">@(isRtl ? "البريد الإلكتروني" : "Email")</small>
                                    <span class="fw-bold">@Model.Email</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-light rounded-circle p-2 me-3"><i class="fas fa-map-marker-alt text-gold"></i></div>
                                <div>
                                    <small class="text-muted d-block">@(isRtl ? "العنوان الوطني" : "National Address")</small>
                                    <span class="fw-bold">@Model.NationalAddressShortCode</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="opacity-10 my-4">

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">@(isRtl ? "البيانات الرسمية" : "Official Data")</h6>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1">@(isRtl ? "الرقم الموحد" : "Unified Number")</small>
                                <strong class="text-dark font-monospace">@Model.UnifiedNumber</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1">@(isRtl ? "الرقم الضريبي" : "Tax Number")</small>
                                <strong class="text-dark font-monospace">@Model.TaxNumber</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1">@(isRtl ? "تاريخ الإضافة" : "Created Date")</small>
                                <strong class="text-dark">@Model.CreatedAt.ToString("yyyy-MM-dd")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- قسم المشروعات والمهن -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-project-diagram text-gold me-2"></i> @(isRtl ? "المشروعات والمهن" : "Projects & Roles")</h6>
                    <button class="btn btn-sm btn-dark rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addProjectModal">
                        <i class="fas fa-plus me-1"></i> @(isRtl ? "إضافة مشروع" : "Add Project")
                    </button>
                </div>
                <div class="card-body p-4">
                    @if (Model.Projects != null && Model.Projects.Any())
                    {
                        <div class="accordion" id="projectsAccordion">
                            @foreach (var project in Model.Projects)
                            {
                                <div class="accordion-item border mb-3 rounded-3 overflow-hidden shadow-sm">
                                    <h2 class="accordion-header" id="heading-@project.Id">
                                        <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@project.Id">
                                            <div class="d-flex justify-content-between align-items-center w-100 pe-3">
                                                <span class="fw-bold text-dark"><i class="fas fa-folder-open text-primary me-2"></i> @project.Name</span>
                                                <span class="badge bg-secondary">@(isRtl ? "البدء:" : "Start:") @project.StartDate.ToString("yyyy-MM-dd")</span>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="collapse-@project.Id" class="accordion-collapse collapse" data-bs-parent="#projectsAccordion">
                                        <div class="accordion-body">
                                            <p class="small text-muted mb-3">@project.Description</p>

                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold small mb-0">@(isRtl ? "المهن / الفرص المتاحة:" : "Job Roles / Opportunities:")</h6>
                                                <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="openRoleModal(@project.Id, '@project.Name')">
                                                    <i class="fas fa-plus me-1"></i> @(isRtl ? "إضافة مهنة" : "Add Role")
                                                </button>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                @if (project.JobRoles != null && project.JobRoles.Any())
                                                {
                                                    foreach (var role in project.JobRoles)
                                                    {
                                                        <!-- التعديل: تغيير لون النص ليكون أبيض على الخلفية الداكنة -->
                                                        <span class="badge bg-dark text-white border border-secondary px-3 py-2 rounded-pill">
                                                            <i class="fas fa-user-tag text-gold me-1"></i> @role.Name
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">@(isRtl ? "لا توجد مهن مضافة" : "No roles added")</span>
                                                }
                                            </div>

                                            <hr class="opacity-10 my-3">
                                            <div class="text-end">
                                                <form asp-action="DeleteProject" method="post" onsubmit="return confirm('@(isRtl ? "هل أنت متأكد من حذف المشروع بكافة مهنه؟" : "Delete project and all its roles?")')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@project.Id" />
                                                    <input type="hidden" name="companyId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"><i class="fas fa-trash me-1"></i> @(isRtl ? "حذف المشروع" : "Delete Project")</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-project-diagram fa-2x mb-2 opacity-25"></i>
                            <p class="mb-0 small">@(isRtl ? "لا توجد مشاريع مضافة لهذه الشركة" : "No projects added for this company")</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Sub Companies Section -->
            @if (Model.SubCompanies != null && Model.SubCompanies.Any())
            {
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white py-3 px-4 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-code-branch text-gold me-2"></i> @(isRtl ? "الفروع / الشركات التابعة" : "Sub-Companies / Branches")</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-4">@(isRtl ? "الاسم" : "Name")</th>
                                        <th>@(isRtl ? "السجل" : "CR No")</th>
                                        <th>@(isRtl ? "المسؤول" : "Responsible")</th>
                                        <th class="text-end pe-4">@(isRtl ? "عرض" : "View")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sub in Model.SubCompanies)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@sub.Name</td>
                                            <td class="font-monospace text-muted">@sub.RegistrationNumber</td>
                                            <td>@sub.ResponsiblePerson</td>
                                            <td class="text-end pe-4">
                                                <a href="/Companies/Details/@sub.Id" class="btn btn-sm btn-outline-dark rounded-circle"><i class="fas fa-chevron-left rtl-flip"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar: Financials & Attachments -->
        <div class="col-lg-4">
            <!-- Subscription Details -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-file-contract text-gold me-2"></i> @(isRtl ? "تفاصيل الاشتراك" : "Subscription Details")</h6>
                </div>
                <div class="card-body p-4">
                    <div class="border-start border-4 border-gold ps-3 mb-4">
                        <small class="text-muted">@(isRtl ? "فترة الاشتراك" : "Subscription Period")</small>
                        <div class="fw-bold fs-6 mt-1">
                            @Model.SubscriptionStartDate.ToString("dd MMM yyyy") <i class="fas fa-arrow-left mx-2 text-muted small rtl-flip"></i> @Model.SubscriptionEndDate.ToString("dd MMM yyyy")
                        </div>
                        @{
                            var daysLeft = (Model.SubscriptionEndDate - DateTime.Now).Days;
                            var badgeColor = daysLeft < 30 ? "text-danger" : "text-success";
                            var statusText = daysLeft > 0 ? (isRtl ? $"متبقي {daysLeft} يوم" : $"{daysLeft} days remaining") : (isRtl ? "منتهي الصلاحية" : "Expired");
                        }
                        <small class="@badgeColor fw-bold mt-1 d-block">
                            @statusText
                        </small>
                    </div>
                    <div class="row text-center">
                        <div class="col-6">
                            <h3 class="fw-bold mb-0 text-dark">@Model.AllowedEmployees</h3>
                            <small class="text-muted">@(isRtl ? "موظف مسموح" : "Allowed Employees")</small>
                        </div>
                        <div class="col-6 border-start">
                            <h3 class="fw-bold mb-0 text-dark">@Model.AllowedSubAccounts</h3>
                            <small class="text-muted">@(isRtl ? "فرع مسموح" : "Allowed Branches")</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financial Card -->
            <div class="card border-0 shadow-lg rounded-4 mb-4 bg-dark text-white">
                <div class="card-body p-4 position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 opacity-10 p-3"><i class="fas fa-coins fa-3x text-gold"></i></div>
                    <h6 class="text-gold text-uppercase letter-spacing-1 mb-4">@(isRtl ? "البيانات المالية" : "Financials")</h6>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">@(isRtl ? "قيمة الموظف:" : "Price per Employee:")</span>
                        <span class="fw-bold">@Model.PricePerEmployee.ToString("N2") SAR</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                        <span class="text-white-50">@(isRtl ? $"الضريبة ({Model.TaxRate}%):" : $"Tax ({Model.TaxRate}%):")</span>
                        <span class="fw-bold">@((Model.PricePerEmployee * Model.TaxRate / 100).ToString("N2")) SAR</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-white">@(isRtl ? "الإجمالي (للموظف):" : "Total (per Employee):")</span>
                        <span class="text-gold fs-4 fw-bold">@Model.TotalPricePerEmployee.ToString("N2") <small class="fs-6">SAR</small></span>
                    </div>

                    <div class="mt-4 pt-3 border-top border-secondary">
                        <small class="text-white-50 d-block mb-1">@(isRtl ? "نظام السداد:" : "Payment Term:")</small>
                        <span class="badge bg-gold text-dark px-3">@Model.PaymentTerm</span>
                    </div>
                </div>
            </div>

            <!-- Attachments Card -->
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-paperclip text-secondary me-2"></i> @(isRtl ? "المرفقات والعقود" : "Attachments")</h6>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                            <div class="icon-box bg-danger bg-opacity-10 text-danger rounded-circle p-2 me-3">
                                <i class="fas fa-file-pdf fa-lg"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="mb-0 fw-bold text-truncate" title="@Model.AttachmentPath">@(isRtl ? "ملف العقد / السجل" : "Contract / CR File")</h6>
                                <small class="text-muted">@(isRtl ? "مرفق" : "Attachment")</small>
                            </div>
                            <a href="/uploads/companies/@Model.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                @(isRtl ? "فتح" : "Open")
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-file-excel fa-2x mb-2 opacity-50"></i>
                            <p class="mb-0 small">@(isRtl ? "لا توجد مرفقات لهذه الشركة" : "No attachments found")</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Project -->
<div class="modal fade" id="addProjectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h6 class="modal-title fw-bold text-gold"><i class="fas fa-plus me-2"></i> @(isRtl ? "إضافة مشروع جديد" : "Add New Project")</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddProject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="companyId" value="@Model.Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isRtl ? "اسم المشروع" : "Project Name")</label>
                        <input type="text" name="projectName" class="form-control bg-light" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isRtl ? "تاريخ البدء" : "Start Date")</label>
                        <input type="date" name="startDate" class="form-control bg-light" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isRtl ? "الوصف" : "Description")</label>
                        <textarea name="description" class="form-control bg-light" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">@(isRtl ? "إلغاء" : "Cancel")</button>
                    <button type="submit" class="btn btn-dark btn-gold text-gold fw-bold rounded-pill px-4">@(isRtl ? "إضافة" : "Add")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Add Job Role -->
<div class="modal fade" id="addRoleModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h6 class="modal-title fw-bold text-gold"><i class="fas fa-user-tag me-2"></i> @(isRtl ? "إضافة مهنة للمشروع" : "Add Job Role")</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddJobRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="companyId" value="@Model.Id" />
                <input type="hidden" name="projectId" id="modalProjectId" />

                <div class="modal-body p-4">
                    <div class="alert alert-light border border-gold small mb-3">
                        <strong>@(isRtl ? "المشروع:" : "Project:")</strong> <span id="modalProjectName" class="text-dark"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isRtl ? "المسمى الوظيفي / المهنة" : "Job Role Name")</label>
                        <input type="text" name="roleName" class="form-control bg-light" required placeholder="@(isRtl ? "مثال: مهندس برمجيات" : "e.g. Software Engineer")" />
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">@(isRtl ? "إلغاء" : "Cancel")</button>
                    <button type="submit" class="btn btn-dark btn-gold text-gold fw-bold rounded-pill px-4">@(isRtl ? "إضافة" : "Add")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRoleModal(projectId, projectName) {
            document.getElementById('modalProjectId').value = projectId;
            document.getElementById('modalProjectName').innerText = projectName;
            new bootstrap.Modal(document.getElementById('addRoleModal')).show();
        }
    </script>
}