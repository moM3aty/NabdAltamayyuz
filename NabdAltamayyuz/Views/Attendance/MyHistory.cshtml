@model IEnumerable<NabdAltamayyuz.Models.Attendance>
@using System.Globalization

@{
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isRtl ? "سجل حضوري" : "My Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var companyName = ViewBag.CompanyName as string ?? "نبض التميز الذهبي";

    // جلب الإجازات المعتمدة لعرضها في سجل الموظف إن تقاطعت مع الأيام المعروضة
    var leaves = ViewBag.MyLeaves as List<NabdAltamayyuz.Models.LeaveRequest> ?? new List<NabdAltamayyuz.Models.LeaveRequest>();
}

<style>
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 1.5cm;
        }

        body {
            background-color: white !important;
            font-family: 'Cairo', sans-serif;
            -webkit-print-color-adjust: exact;
        }

        .premium-navbar, footer, .btn, .alert, .no-print, .action-buttons-container {
            display: none !important;
        }

        .container {
            margin-top: 0 !important;
            padding: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .card-body {
            padding: 0 !important;
        }

        .print-header {
            display: flex !important;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #D4AF37;
            padding-bottom: 15px;
            margin-bottom: 25px;
            page-break-after: avoid;
        }

            .print-header h4 {
                color: #D4AF37;
                font-weight: bold;
                margin: 0;
            }

            .print-header h5 {
                color: #0F172A;
                font-weight: bold;
                margin: 5px 0 0 0;
            }

            .print-header p {
                color: #64748b;
                font-size: 12px;
                margin: 0;
            }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 13px;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        th {
            background-color: #0F172A !important;
            color: white !important;
            border: 1px solid #000 !important;
            padding: 10px !important;
        }

        td {
            border: 1px solid #ccc !important;
            padding: 8px !important;
            color: black !important;
        }

        .badge {
            border: 1px solid #000;
            background: transparent !important;
            color: black !important;
            padding: 3px 8px;
        }
    }

    .print-header {
        display: none;
    }
</style>

<div class="container py-5 animate-fade-in" style="margin-top: 120px;">

    <div class="print-header">
        <div>
            <h4><i class="fas fa-building me-2"></i> @companyName</h4>
            <h5>@(isRtl ? "سجل الحضور والانصراف للموظف" : "Employee Attendance Log")</h5>
        </div>
        <div style="text-align: @(isRtl ? "left" : "right")">
            <p><strong>@(isRtl ? "اسم الموظف:" : "Employee:")</strong> @User.Identity.Name</p>
            <p><strong>@(isRtl ? "تاريخ الطباعة:" : "Print Date:")</strong> @DateTime.UtcNow.AddHours(3).ToString("yyyy-MM-dd HH:mm")</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 no-print action-buttons-container">
        <div>
            <h3 class="fw-bold text-dark"><i class="fas fa-history text-gold me-2"></i> @(isRtl ? "سجل الحضور الشخصي" : "My Attendance History")</h3>
            <p class="text-muted small">@(isRtl ? "عرض سجلات الدوام لآخر 30 يوم" : "Showing records for the last 30 days")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary shadow-sm rounded-pill px-4" onclick="window.print()">
                <i class="fas fa-print me-2"></i> @(isRtl ? "طباعة السجل" : "Print Log")
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="py-3">@(isRtl ? "التاريخ" : "Date")</th>
                            <th class="py-3">@(isRtl ? "اليوم" : "Day")</th>
                            <th class="py-3">@(isRtl ? "دخول" : "Time In")</th>
                            <th class="py-3">@(isRtl ? "خروج" : "Time Out")</th>
                            <th class="py-3">@(isRtl ? "ساعات العمل" : "Work Hours")</th>
                            <th class="py-3">@(isRtl ? "الحالة" : "Status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                // التعديل: إظهار الإجازة إن وجدت ضمن أيام الحضور
                                var empLeave = leaves.FirstOrDefault(l => l.StartDate <= item.Date && l.EndDate >= item.Date);
                                bool hasLeave = empLeave != null;
                                string leaveName = "";
                                if (hasLeave)
                                {
                                    leaveName = empLeave.Type switch
                                    {
                                        NabdAltamayyuz.Models.LeaveType.Annual => "إجازة سنوية",
                                        NabdAltamayyuz.Models.LeaveType.Unpaid => "بدون أجر",
                                        NabdAltamayyuz.Models.LeaveType.Sick => "إجازة مرضية",
                                        NabdAltamayyuz.Models.LeaveType.Marriage => "إجازة زواج",
                                        NabdAltamayyuz.Models.LeaveType.Maternity => "إجازة مولود",
                                        NabdAltamayyuz.Models.LeaveType.Exams => "إجازة اختبارات",
                                        NabdAltamayyuz.Models.LeaveType.Hajj => "إجازة حج",
                                        NabdAltamayyuz.Models.LeaveType.Death => "إجازة وفاة",
                                        _ => empLeave.CustomTypeName ?? "أخرى"
                                    };
                                }

                                <tr>
                                    <td><span class="fw-bold">@item.Date.ToString("yyyy-MM-dd")</span></td>
                                    <td>@item.Date.ToString("dddd", CultureInfo.CurrentCulture)</td>
                                    <td class="text-success font-monospace" dir="ltr">@(item.TimeIn?.ToString("hh:mm tt") ?? "--")</td>
                                    <td class="text-danger font-monospace" dir="ltr">@(item.TimeOut?.ToString("hh:mm tt") ?? "--")</td>
                                    <td>
                                        @if (item.TimeIn.HasValue && item.TimeOut.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @((item.TimeOut.Value - item.TimeIn.Value).TotalHours.ToString("0.0")) @(isRtl ? "س" : "h")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (hasLeave)
                                        {
                                            <span class="badge bg-info text-dark rounded-pill">@(isRtl ? "إجازة" : "Leave") (@leaveName)</span>
                                        }
                                        else if (item.TimeOut == null)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill">@(isRtl ? "جاري العمل" : "Working")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">@(isRtl ? "مكتمل" : "Completed")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">@(isRtl ? "لا يوجد سجلات حضور" : "No attendance records found")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>