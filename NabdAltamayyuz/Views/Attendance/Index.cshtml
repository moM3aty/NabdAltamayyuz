@model IEnumerable<NabdAltamayyuz.Models.Attendance>
@using System.Globalization
@using NabdAltamayyuz.Models

@{
    ViewData["Title"] = "سجل الحضور والانصراف";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isCompanyAdmin = User.IsInRole("CompanyAdmin");

    var selectedDateStr = ViewBag.SelectedDate as string;
    var dayName = ViewBag.DayName as string;

    // جلب الإجازات المتقاطعة مع هذا اليوم
    var dailyLeaves = ViewBag.DailyLeaves as List<LeaveRequest> ?? new List<LeaveRequest>();
}

<style>
    @@media print {
        @@page {
            size: A4 landscape;
            margin: 1cm;
        }

        body {
            background-color: white !important;
            font-family: 'Cairo', sans-serif;
            -webkit-print-color-adjust: exact;
        }

        .premium-navbar, footer, .btn, .card-header, .card-footer, form, .alert, .no-print, .filters-card {
            display: none !important;
        }

        .container {
            margin-top: 0 !important;
            padding: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .card-body {
            padding: 0 !important;
        }

        .print-header {
            display: block !important;
            margin-bottom: 20px;
            border-bottom: 2px solid #D4AF37;
            padding-bottom: 10px;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 12px;
        }

        th {
            background-color: #0F172A !important;
            color: white !important;
            border: 1px solid #000 !important;
            padding: 5px !important;
        }

        td {
            border: 1px solid #ccc !important;
            padding: 5px !important;
            color: black !important;
        }

        .badge {
            border: 1px solid #000;
            background: transparent !important;
            color: black !important;
            padding: 2px 5px;
        }
    }

    .print-header {
        display: none;
    }
</style>

@Html.AntiForgeryToken()

<div class="container py-5 animate-fade-in" style="margin-top: 120px;">

    <!-- ترويسة الطباعة -->
    <div class="print-header text-center">
        <div class="row align-items-center">
            <div class="col-4 text-end"><small>تاريخ: @DateTime.UtcNow.AddHours(3).ToString("yyyy-MM-dd HH:mm")</small></div>
            <div class="col-4"><h3 class="fw-bold mb-1">نبض التميز الذهبي</h3><h5 class="text-muted">تقرير الحضور - @selectedDateStr</h5></div>
            <div class="col-4 text-start"><small>@User.Identity.Name</small></div>
        </div>
    </div>

    <!-- Header & Date Display -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3 no-print">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fas fa-clipboard-list text-gold me-2"></i> @(isRtl ? "سجل الحضور والانصراف (مع الإجازات)" : "Attendance & Leaves Log")
            </h3>
            <div class="d-flex align-items-center mt-2 text-muted">
                <span class="badge bg-gold text-dark me-2">@dayName</span>
                <span class="fw-bold"><i class="far fa-calendar-alt me-1"></i> @selectedDateStr</span>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap justify-content-center">
            @if (isSuperAdmin || isCompanyAdmin)
            {
                <button class="btn btn-primary shadow-sm rounded-pill px-4 hover-scale" onclick="submitWeeklyReport()">
                    <i class="fas fa-cloud-upload-alt me-2"></i> إرسال للمنصة
                </button>
            }
            <div class="dropdown">
                <button class="btn btn-outline-secondary shadow-sm rounded-pill px-4 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-download me-2"></i> @(isRtl ? "تصدير" : "Export")
                </button>
                <ul class="dropdown-menu shadow-lg border-0">
                    <li><button class="dropdown-item" onclick="window.print()"><i class="fas fa-print me-2"></i> طباعة / PDF</button></li>
                    <li><button class="dropdown-item" onclick="exportToExcel('attendanceTable')"><i class="fas fa-file-excel me-2 text-success"></i> Excel</button></li>
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success rounded-3 shadow-sm mb-4 fade show no-print">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-lg mb-4 bg-white rounded-4 overflow-hidden no-print filters-card">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                @if (isSuperAdmin)
                {
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">الشركة</label>
                        <select name="companyId" id="filterCompanyId" class="form-select bg-light border-0" asp-items="ViewBag.Companies">
                            <option value="">-- كل الشركات --</option>
                        </select>
                    </div>
                }

                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">اسم الموظف</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light border-end-0 text-gold"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchEmployee" class="form-control bg-light border-start-0" placeholder="بحث..." value="@ViewBag.CurrentSearch">
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">التاريخ</label>
                    <input type="date" name="date" class="form-control bg-light border-0 shadow-sm fw-bold text-primary" value="@selectedDateStr" onchange="this.form.submit()">
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">الحالة الوظيفية</label>
                    <select name="status" class="form-select bg-light border-0 shadow-sm">
                        <option value="">-- الكل --</option>
                        <option value="Active" selected="@(ViewBag.CurrentStatus == "Active")">نشط</option>
                        <option value="Inactive" selected="@(ViewBag.CurrentStatus == "Inactive")">غير نشط</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100 fw-bold rounded-pill shadow-sm">عرض النتائج</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="attendanceTable" class="table table-hover align-middle mb-0 text-center">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="py-3 px-3 text-start">@(isRtl ? "الموظف" : "Employee")</th>
                            @if (isSuperAdmin)
                            {
                                <th class="py-3">الشركة</th>
                            }
                            <th class="py-3">@(isRtl ? "حالة الحضور/الإجازة" : "Status")</th>
                            <th class="py-3">@(isRtl ? "وقت الدخول" : "Time In")</th>
                            <th class="py-3">@(isRtl ? "وقت الخروج" : "Time Out")</th>
                            <th class="py-3">@(isRtl ? "الساعات" : "Hrs")</th>
                            <th class="py-3 text-end pe-4 no-print">@(isRtl ? "إجراءات" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var isAbsent = (item.Id == 0 || item.TimeIn == null);
                                var isWorking = (!isAbsent && item.TimeOut == null);
                                var isCompleted = (!isAbsent && item.TimeOut != null);

                                // Check if employee has leave for this date
                                var empLeave = dailyLeaves.FirstOrDefault(l => l.EmployeeId == item.EmployeeId);
                                bool hasLeave = empLeave != null;

                                <tr id="tr-@item.EmployeeId" class="@(isAbsent && !hasLeave ? "bg-danger bg-opacity-10" : (hasLeave ? "bg-info bg-opacity-10" : ""))">
                                    <td class="text-start px-3">
                                        <div class="d-flex align-items-center">
                                            <div id="avatar-@item.EmployeeId" class="avatar-circle @(isAbsent && !hasLeave ? "bg-danger text-white" : "bg-light text-gold") rounded-circle d-flex align-items-center justify-content-center me-2 border border-gold no-print" style="width: 35px; height: 35px;">
                                                <span class="fw-bold small">@item.Employee.FullName.Substring(0, 1).ToUpper()</span>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small">@item.Employee.FullName</div>
                                                <small class="text-muted no-print" style="font-size: 0.7rem;">@item.Employee.JobTitle</small>
                                            </div>
                                        </div>
                                    </td>
                                    @if (isSuperAdmin)
                                    {
                                        <td class="small text-muted">@(item.Employee.Company?.Name ?? "-")</td>
                                    }

                                    <td id="status-@item.EmployeeId">
                                        @if (hasLeave)
                                        {
                                            var typeName = empLeave.Type switch
                                            {
                                                NabdAltamayyuz.Models.LeaveType.Annual => "إجازة سنوية",
                                                NabdAltamayyuz.Models.LeaveType.Unpaid => "بدون أجر",
                                                NabdAltamayyuz.Models.LeaveType.Sick => "إجازة مرضية",
                                                NabdAltamayyuz.Models.LeaveType.Marriage => "إجازة زواج",
                                                NabdAltamayyuz.Models.LeaveType.Maternity => "إجازة مولود",
                                                NabdAltamayyuz.Models.LeaveType.Exams => "إجازة اختبارات",
                                                NabdAltamayyuz.Models.LeaveType.Hajj => "إجازة حج",
                                                NabdAltamayyuz.Models.LeaveType.Death => "إجازة وفاة",
                                                _ => empLeave.CustomTypeName ?? "أخرى"
                                            };

                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <a href="/Leaves/Print/@empLeave.Id" target="_blank" class="badge bg-info text-dark text-decoration-none shadow-sm px-3 py-2">
                                                    <i class="fas fa-umbrella-beach me-1"></i> @typeName
                                                </a>

                                                @if (empLeave.Status == LeaveStatus.Pending)
                                                {
                                                    <form action="/Leaves/UpdateStatus" method="post" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@empLeave.Id" />
                                                        <input type="hidden" name="status" value="Approved" />
                                                        <input type="hidden" name="returnUrl" value="/Attendance/Index?date=@selectedDateStr" />
                                                        <button type="submit" class="btn btn-sm text-success p-0 hover-scale" title="موافقة"><i class="fas fa-check-circle fs-5"></i></button>
                                                    </form>
                                                    <form action="/Leaves/UpdateStatus" method="post" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@empLeave.Id" />
                                                        <input type="hidden" name="status" value="Rejected" />
                                                        <input type="hidden" name="returnUrl" value="/Attendance/Index?date=@selectedDateStr" />
                                                        <button type="submit" class="btn btn-sm text-danger p-0 hover-scale" title="رفض"><i class="fas fa-times-circle fs-5"></i></button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="badge @(empLeave.Status == LeaveStatus.Approved ? "bg-success" : "bg-danger")" title="حالة الطلب">@empLeave.Status</span>
                                                }
                                            </div>
                                        }
                                        else if (isAbsent)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">غائب</span>
                                        }
                                        else if (isWorking)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">حاضر (جاري)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">حاضر (مكتمل)</span>
                                        }

                                        @if (item.IsManualEntry && !hasLeave)
                                        {
                                            <i class="fas fa-pen text-info ms-1 small" title="تم التعديل يدوياً"></i>
                                        }
                                    </td>

                                    <td id="timeIn-@item.EmployeeId" class="text-success ltr font-monospace fw-bold small">@(item.TimeIn?.ToString("HH:mm") ?? "--:--")</td>
                                    <td id="timeOut-@item.EmployeeId" class="text-danger ltr font-monospace fw-bold small">@(item.TimeOut?.ToString("HH:mm") ?? "--:--")</td>

                                    <td id="totalHours-@item.EmployeeId">
                                        @if (isCompleted)
                                        {
                                            <span class="badge bg-light text-dark border fw-bold">@((item.TimeOut.Value - item.TimeIn.Value).TotalHours.ToString("0.0"))</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--</span>
                                        }
                                    </td>

                                    <td class="text-end pe-4 no-print">
                                        <div class="d-flex justify-content-end gap-1" id="actions-@item.EmployeeId">
                                            @if (isAbsent && !hasLeave)
                                            {
                                                <button class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" onclick="quickAction(event, @item.EmployeeId, '@selectedDateStr', 'In')"><i class="fas fa-sign-in-alt me-1"></i> دخول</button>
                                                <!-- Add Leave Button for Manager -->
                                                <button class="btn btn-sm btn-primary rounded-circle ms-1 shadow-sm" title="تسجيل إجازة للموظف" onclick="openLeaveModal(@item.EmployeeId, '@item.Employee.FullName', '@selectedDateStr')"><i class="fas fa-calendar-plus"></i></button>
                                            }
                                            else if (isWorking && !hasLeave)
                                            {
                                                <button class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm" onclick="quickAction(event, @item.EmployeeId, '@selectedDateStr', 'Out')"><i class="fas fa-sign-out-alt me-1"></i> انصراف</button>
                                            }

                                            <button class="btn btn-sm btn-outline-dark rounded-circle ms-2" title="تعديل السجل" onclick="openManualEntry(@item.EmployeeId, document.querySelector('#tr-@item.EmployeeId .fw-bold.text-dark.small').innerText, document.getElementById('timeIn-@item.EmployeeId').innerText, document.getElementById('timeOut-@item.EmployeeId').innerText, '@item.Notes')"><i class="fas fa-edit"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="@(isSuperAdmin ? 7 : 6)" class="text-center py-5 text-muted small">لا يوجد موظفين لعرضهم</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center no-print">
            <small class="text-muted">@(isRtl ? $"إجمالي الموظفين: {Model?.Count() ?? 0}" : $"Total Employees: {Model?.Count() ?? 0}")</small>
        </div>
    </div>
</div>

<!-- Manual Entry / Edit Modal -->
<div class="modal fade" id="manualEntryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 px-4 py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fas fa-pen-alt text-gold me-2"></i> تعديل السجل يدوياً</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Attendance/ManualEntry" method="post" id="attendanceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="employeeId" id="modalEmployeeId" />
                <input type="hidden" name="date" value="@selectedDateStr" />

                <div class="modal-body p-4">
                    <div class="alert alert-light border-gold border-start border-4 mb-4">
                        <strong class="text-dark d-block mb-1">الموظف:</strong>
                        <span id="modalEmployeeName" class="text-gold fw-bold fs-5"></span>
                        <div class="small text-muted mt-1">التاريخ: @selectedDateStr</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">وقت الدخول</label>
                            <input type="time" name="timeIn" id="modalTimeIn" class="form-control bg-light text-success fw-bold">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">وقت الخروج</label>
                            <input type="time" name="timeOut" id="modalTimeOut" class="form-control bg-light text-danger fw-bold">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">ملاحظات (سبب التعديل)</label>
                        <textarea name="notes" id="modalNotes" class="form-control bg-light" rows="2" placeholder="اختياري..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-gold bg-dark text-gold fw-bold rounded-pill px-4 shadow-sm hover-scale">حفظ البيانات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manager Leave Assignment Modal -->
<div class="modal fade" id="assignLeaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 px-4 py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-calendar-plus me-2"></i> إسناد إجازة للموظف</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Leaves/Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmployeeId" id="leaveModalEmpId" />

                <div class="modal-body p-4">
                    <div class="alert alert-light border-primary border-start border-4 mb-4">
                        <strong class="text-dark d-block mb-1">تسجيل إجازة للموظف:</strong>
                        <span id="leaveModalEmpName" class="text-primary fw-bold fs-5"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">نوع الإجازة</label>
                        <select name="Type" id="managerLeaveTypeSelect" class="form-select bg-light" required onchange="checkManagerCustomType(this.value)">
                            <option value="Annual">إجازة سنوية</option>
                            <option value="Unpaid">إجازة بدون أجر</option>
                            <option value="Sick">إجازة مرضية</option>
                            <option value="Marriage">إجازة زواج</option>
                            <option value="Maternity">إجازة مولود</option>
                            <option value="Exams">إجازة اختبارات</option>
                            <option value="Hajj">إجازة حج</option>
                            <option value="Death">إجازة وفاة</option>
                            <option value="Other">أخرى</option>
                        </select>
                    </div>

                    <div class="mb-3" id="managerCustomTypeDiv" style="display: none;">
                        <label class="form-label fw-bold small text-primary">اسم الإجازة (أخرى)</label>
                        <input type="text" name="CustomTypeName" class="form-control border-primary" placeholder="حدد نوع الإجازة بدقة" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">من تاريخ</label>
                            <input type="date" name="StartDate" id="managerLeaveStartDate" class="form-control bg-light" required onchange="calcManagerDuration()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">إلى تاريخ</label>
                            <input type="date" name="EndDate" id="managerLeaveEndDate" class="form-control bg-light" required onchange="calcManagerDuration()" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">مدة الإجازة (أيام)</label>
                        <input type="number" name="DurationDays" id="managerLeaveDuration" class="form-control bg-white fw-bold text-center text-primary fs-5" readonly required />
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm hover-scale">تسجيل واعتماد الإجازة</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickAction(event, employeeId, dateStr, actionType) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            var btn = event.currentTarget;
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            fetch('/Attendance/QuickAction', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    'employeeId': employeeId,
                    'date': dateStr,
                    'actionType': actionType
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    var tr = document.getElementById('tr-' + employeeId);
                    var avatar = document.getElementById('avatar-' + employeeId);
                    var empName = document.querySelector('#tr-' + employeeId + ' .fw-bold.text-dark.small').innerText;

                    tr.classList.remove('bg-danger', 'bg-opacity-10');
                    avatar.classList.remove('bg-danger', 'text-white');
                    avatar.classList.add('bg-light', 'text-gold');

                    var actionsDiv = document.getElementById('actions-' + employeeId);

                    if (actionType === 'In') {
                        document.getElementById('timeIn-' + employeeId).innerText = data.timeStr;
                        document.getElementById('status-' + employeeId).innerHTML = '<span class="badge bg-warning text-dark rounded-pill px-3 py-2">حاضر (جاري)</span> <i class="fas fa-pen text-info ms-1 small" title="تسجيل سريع"></i>';

                        actionsDiv.innerHTML = `
                            <button class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm" onclick="quickAction(event, ${employeeId}, '${dateStr}', 'Out')"><i class="fas fa-sign-out-alt me-1"></i> انصراف</button>
                            <button class="btn btn-sm btn-outline-dark rounded-circle ms-2" onclick="openManualEntry(${employeeId}, '${empName}', '${data.timeStr}', '--:--', '')"><i class="fas fa-edit"></i></button>
                        `;
                    }
                    else if (actionType === 'Out') {
                        document.getElementById('timeOut-' + employeeId).innerText = data.timeStr;
                        document.getElementById('status-' + employeeId).innerHTML = '<span class="badge bg-success rounded-pill px-3 py-2">حاضر (مكتمل)</span> <i class="fas fa-pen text-info ms-1 small" title="تسجيل سريع"></i>';

                        document.getElementById('totalHours-' + employeeId).innerHTML = `<span class="badge bg-light text-dark border fw-bold">${data.totalHours}</span>`;

                        var currentInTime = document.getElementById('timeIn-' + employeeId).innerText;
                        actionsDiv.innerHTML = `
                            <span class="text-success small fw-bold me-2 mt-1"><i class="fas fa-check-double"></i> تمت الحركة</span>
                            <button class="btn btn-sm btn-outline-dark rounded-circle ms-2" onclick="openManualEntry(${employeeId}, '${empName}', '${currentInTime}', '${data.timeStr}', '')"><i class="fas fa-edit"></i></button>
                        `;
                    }
                } else {
                    alert("خطأ: " + data.message);
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            })
            .catch(err => {
                alert("حدث خطأ في الاتصال");
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            });
        }

        function openManualEntry(empId, empName, timeIn, timeOut, notes) {
            document.getElementById('modalEmployeeId').value = empId;
            document.getElementById('modalEmployeeName').innerText = empName;
            document.getElementById('modalTimeIn').value = timeIn !== '--:--' ? timeIn : '';
            document.getElementById('modalTimeOut').value = timeOut !== '--:--' ? timeOut : '';
            document.getElementById('modalNotes').value = notes !== 'null' && notes !== '' ? notes : '';

            new bootstrap.Modal(document.getElementById('manualEntryModal')).show();
        }

        // دالة للمدير لتسجيل إجازة لموظف من شاشة الحضور
        function openLeaveModal(empId, empName, dateStr) {
            document.getElementById('leaveModalEmpId').value = empId;
            document.getElementById('leaveModalEmpName').innerText = empName;
            document.getElementById('managerLeaveStartDate').value = dateStr;
            document.getElementById('managerLeaveEndDate').value = dateStr;
            calcManagerDuration();
            new bootstrap.Modal(document.getElementById('assignLeaveModal')).show();
        }

        function checkManagerCustomType(val) {
            var div = document.getElementById('managerCustomTypeDiv');
            if (val === 'Other') div.style.display = 'block';
            else div.style.display = 'none';
        }

        function calcManagerDuration() {
            var start = document.getElementById('managerLeaveStartDate').value;
            var end = document.getElementById('managerLeaveEndDate').value;
            if (start && end) {
                var d1 = new Date(start);
                var d2 = new Date(end);
                if (d2 >= d1) {
                    var diffTime = Math.abs(d2 - d1);
                    var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                    document.getElementById('managerLeaveDuration').value = diffDays;
                } else {
                    document.getElementById('managerLeaveDuration').value = 0;
                }
            }
        }

        function exportToExcel(tableId) {
            let table = document.getElementById(tableId);
            var clone = table.cloneNode(true);
            var rows = clone.rows;
            for (var i = 0; i < rows.length; i++) {
                var cells = rows[i].cells;
                for (var j = cells.length - 1; j >= 0; j--) {
                    if (cells[j].classList.contains('no-print') || cells[j].querySelector('button')) {
                        rows[i].deleteCell(j);
                    }
                }
            }
            let html = clone.outerHTML;
            var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8' });
            var url = URL.createObjectURL(blob);
            let a = document.createElement('a');
            a.href = url;
            a.download = 'Attendance_Report.xls';
            a.click();
        }

        function submitWeeklyReport() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var companyId = '';
            var filterCompanySelect = document.getElementById("filterCompanyId");

            if (filterCompanySelect) {
                if (!filterCompanySelect.value) {
                    alert("يرجى اختيار الشركة من الفلتر أولاً.");
                    return;
                }
                companyId = filterCompanySelect.value;
            }

            // Using direct fetch without JS confirm as requested by standard policy unless handled cleanly
            var btn = event.currentTarget;
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> جاري الإرسال...';
            btn.disabled = true;

            fetch('/Attendance/SubmitWeeklyData?companyId=' + companyId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }
            })
            .then(res => res.json())
            .then(data => { alert(data.message); location.reload(); })
            .catch(err => { alert("حدث خطأ في الاتصال"); })
            .finally(() => { btn.innerHTML = originalHtml; btn.disabled = false; });
        }
    </script>
}