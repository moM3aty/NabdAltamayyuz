@model NabdAltamayyuz.Models.ApplicationUser
@using NabdAltamayyuz.Models
@using System.Globalization

@{
    ViewData["Title"] = "إضافة مستخدم جديد";
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isCompanyAdmin = User.IsInRole("CompanyAdmin");
}

<div class="container py-5 animate-fade-in" style="margin-top: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-3 border-0 d-flex justify-content-between align-items-center px-4">
                    <h5 class="mb-0 fw-bold text-gold">
                        <i class="fas fa-user-plus me-2"></i> @(isRtl ? "إضافة مستخدم جديد" : "Add New User")
                    </h5>
                    <a href="/Employees" class="btn btn-sm btn-outline-light rounded-pill border-secondary text-white-50 hover-white">
                        <i class="fas fa-times me-1"></i> @(isRtl ? "إلغاء" : "Cancel")
                    </a>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm rounded-3 mb-4">
                            <h6 class="fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> يرجى تصحيح الأخطاء التالية:</h6>
                            <div asp-validation-summary="All" class="text-danger small mb-0 ps-3"></div>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger text-center">@TempData["Error"]</div>
                    }

                    <form asp-action="Create" enctype="multipart/form-data" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Role & Company Selection -->
                        <div class="row g-4 mb-4 bg-light p-3 rounded-3 border border-secondary border-opacity-10">
                            @if (isSuperAdmin)
                            {
                                <div class="col-md-6">
                                    <label asp-for="CompanyId" class="form-label fw-bold small text-gold">الشركة التابع لها</label>
                                    <select asp-for="CompanyId" id="companySelect" class="form-select" asp-items="ViewBag.Companies" onchange="loadProjects(this.value)">
                                        <option value="">-- اختر الشركة --</option>
                                    </select>
                                </div>
                            }
                            else
                            {
                                <!-- حقل مخفي لتحفيز تحميل المشاريع للشركة الحالية عند فتح الصفحة -->
                                <input type="hidden" id="hiddenCompanyId" value="@(Model?.CompanyId ?? 0)" />
                            }

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-gold">نوع المستخدم (الصلاحية)</label>
                                <select name="selectedRole" class="form-select">
                                    <option value="@UserRole.Employee">موظف (Employee)</option>
                                    @if (isSuperAdmin || isCompanyAdmin)
                                    {
                                        <option value="@UserRole.SubAdmin">مشرف فرعي (Sub Admin)</option>
                                    }
                                    @if (isSuperAdmin)
                                    {
                                        <option value="@UserRole.CompanyAdmin">مشرف رئيسي (Company Admin)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Personal Info -->
                        <h6 class="text-dark fw-bold mb-3 border-bottom pb-2">@(isRtl ? "البيانات الشخصية" : "Personal Info")</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold small">@(isRtl ? "الاسم الرباعي" : "Full Name")</label>
                                <input asp-for="FullName" class="form-control bg-light" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NationalId" class="form-label fw-bold small">@(isRtl ? "رقم الهوية / الإقامة" : "National ID / Iqama")</label>
                                <input asp-for="NationalId" class="form-control bg-light" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold small">@(isRtl ? "رقم الجوال" : "Phone Number")</label>
                                <input asp-for="PhoneNumber" class="form-control bg-light" placeholder="05xxxxxxxx" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold small">@(isRtl ? "البريد الإلكتروني" : "Email")</label>
                                <input asp-for="Email" type="email" class="form-control bg-light" placeholder="user@company.com" required />
                            </div>
                        </div>

                        <!-- Job & Project Info -->
                        <h6 class="text-dark fw-bold mb-3 border-bottom pb-2 pt-2">@(isRtl ? "بيانات الوظيفة والمشروع" : "Job & Project Details")</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="HireDate" class="form-label fw-bold small text-primary">@(isRtl ? "تاريخ التعيين" : "Hire Date")</label>
                                <input asp-for="HireDate" type="date" class="form-control bg-light border-primary border-opacity-50" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProjectId" class="form-label fw-bold small">@(isRtl ? "المشروع المسند إليه" : "Assigned Project")</label>
                                <select asp-for="ProjectId" id="projectSelect" class="form-select bg-light" onchange="loadRoles(this.value)">
                                    <option value="">@(isRtl ? "-- بدون مشروع (عام) --" : "-- No Project (General) --")</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProjectJobRoleId" class="form-label fw-bold small">@(isRtl ? "المهنة / المسمى الوظيفي (حسب المشروع)" : "Job Role (Based on Project)")</label>
                                <select asp-for="ProjectJobRoleId" id="roleSelect" class="form-select bg-light" onchange="setJobTitle(this)">
                                    <option value="">@(isRtl ? "-- اختر مهنة أولاً --" : "-- Select Role First --")</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="JobTitle" class="form-label fw-bold small">@(isRtl ? "المسمى الوظيفي المباشر" : "Direct Job Title")</label>
                                <input asp-for="JobTitle" id="jobTitleInput" class="form-control bg-light" placeholder="@(isRtl ? "يملأ تلقائياً عند اختيار المهنة أو يكتب يدوياً" : "Auto-filled or typed manually")" required />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-muted">@(isRtl ? "كلمة المرور الافتراضية للكل" : "Default Password")</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="fas fa-lock"></i></span>
                                    <input type="text" class="form-control bg-light text-muted border-0" value="123456" readonly />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold small">@(isRtl ? "مرفقات (صورة الهوية / العقد)" : "Attachments")</label>
                                <input type="file" name="attachment" class="form-control bg-light" />
                                <div class="form-text small">@(isRtl ? "صيغ مسموحة: PDF, JPG, PNG" : "Allowed: PDF, JPG, PNG")</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="submit" class="btn btn-gold bg-dark text-gold fw-bold px-5 py-2 rounded-pill hover-scale shadow-sm">
                                <i class="fas fa-check me-2"></i> @(isRtl ? "حفظ البيانات" : "Save Data")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // دالة جلب المشاريع بناءً على الشركة
        function loadProjects(companyId) {
            var projectSelect = document.getElementById("projectSelect");
            var roleSelect = document.getElementById("roleSelect");

            projectSelect.innerHTML = "<option value=''>جار التحميل...</option>";
            roleSelect.innerHTML = "<option value=''>-- اختر مشروع أولاً --</option>";

            if (!companyId) {
                projectSelect.innerHTML = "<option value=''>-- بدون مشروع (عام) --</option>";
                return;
            }

            fetch('/Employees/GetProjectsByCompany?companyId=' + companyId)
                .then(res => res.json())
                .then(data => {
                    projectSelect.innerHTML = "<option value=''>-- بدون مشروع (عام) --</option>";
                    data.forEach(item => {
                        var opt = document.createElement("option");
                        opt.value = item.id;
                        opt.text = item.name;
                        projectSelect.appendChild(opt);
                    });
                });
        }

        // دالة جلب المهن بناءً على المشروع
        function loadRoles(projectId) {
            var roleSelect = document.getElementById("roleSelect");

            roleSelect.innerHTML = "<option value=''>جار التحميل...</option>";

            if (!projectId) {
                roleSelect.innerHTML = "<option value=''>-- اختر مشروع أولاً --</option>";
                return;
            }

            fetch('/Employees/GetRolesByProject?projectId=' + projectId)
                .then(res => res.json())
                .then(data => {
                    roleSelect.innerHTML = "<option value=''>-- اختر المهنة --</option>";
                    data.forEach(item => {
                        var opt = document.createElement("option");
                        opt.value = item.id;
                        opt.text = item.name;
                        roleSelect.appendChild(opt);
                    });
                });
        }

        // عند اختيار مهنة، ضع اسمها في حقل المسمى الوظيفي
        function setJobTitle(selectElement) {
            var text = selectElement.options[selectElement.selectedIndex].text;
            var val = selectElement.value;
            var jobTitleInput = document.getElementById("jobTitleInput");
            if(val) {
                jobTitleInput.value = text;
                jobTitleInput.readOnly = true; // نمنع التعديل اليدوي طالما اختار من القائمة
            } else {
                jobTitleInput.value = "";
                jobTitleInput.readOnly = false;
            }
        }

        // إذا كان المستخدم ليس سوبر أدمن، نحمل مشاريعه تلقائياً عند فتح الصفحة
        window.onload = function() {
            var hiddenCompId = document.getElementById("hiddenCompanyId");
            if(hiddenCompId && hiddenCompId.value > 0) {
                // نطلب جلب المشاريع للشركة الحالية الخاصة بالمدير
                fetch('/Employees/GetProjectsByCompany?companyId=' + hiddenCompId.value)
                .then(res => res.json())
                .then(data => {
                    var projectSelect = document.getElementById("projectSelect");
                    projectSelect.innerHTML = "<option value=''>-- بدون مشروع (عام) --</option>";
                    data.forEach(item => {
                        var opt = document.createElement("option");
                        opt.value = item.id;
                        opt.text = item.name;
                        projectSelect.appendChild(opt);
                    });
                });
            }
        };
    </script>
}