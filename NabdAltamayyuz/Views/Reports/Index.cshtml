@using System.Globalization
@using NabdAltamayyuz.Models
@{
    var isRtl = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isRtl ? "مركز التقارير" : "Reports Center";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isEmployee = User.IsInRole("Employee");
}

<div class="container py-5 animate-fade-in" style="margin-top: 120px;">

    <div class="text-center mb-5">
        <div class="icon-box-lg mx-auto bg-dark text-gold rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="fas fa-print fa-3x"></i>
        </div>
        <h3 class="fw-bold text-dark">@(isRtl ? "مركز التقارير والطباعة" : "Reports & Print Center")</h3>
        <p class="text-muted">@(isRtl ? "استخراج تقارير تفصيلية بصيغة قابلة للطباعة" : "Generate detailed printable reports")</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-3 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-sliders-h text-gold me-2"></i>
                        <h5 class="mb-0 fw-bold">@(isRtl ? "إعدادات التقرير" : "Report Settings")</h5>
                    </div>
                    @if (!isEmployee)
                    {
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill" onclick="syncMonthlyTeleworks()">
                            <i class="fas fa-cloud-upload-alt me-1"></i> ترحيل التفاعل الشهري للمنصة
                        </button>
                    }
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form action="/Reports/Generate" method="get" target="_blank">

                        <!-- 1. نوع التقرير -->
                        <label class="form-label fw-bold small text-muted mb-3">@(isRtl ? "اختر نوع التقرير:" : "Select Report Type:")</label>
                        <div class="row g-3 mb-4">
                            <!-- تقرير الحضور -->
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="type" id="rep_attendance" value="attendance" checked>
                                <label class="btn btn-outline-light text-dark border-secondary w-100 p-3 h-100 d-flex flex-column align-items-center justify-content-center hover-border-gold" for="rep_attendance">
                                    <i class="fas fa-clock fa-2x mb-2 text-primary"></i>
                                    <span class="fw-bold">@(isRtl ? "سجل الحضور" : "Attendance")</span>
                                </label>
                            </div>

                            <!-- تقرير المهام -->
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="type" id="rep_tasks" value="tasks">
                                <label class="btn btn-outline-light text-dark border-secondary w-100 p-3 h-100 d-flex flex-column align-items-center justify-content-center hover-border-gold" for="rep_tasks">
                                    <i class="fas fa-tasks fa-2x mb-2 text-warning"></i>
                                    <span class="fw-bold">@(isRtl ? "تقرير المهام" : "Tasks")</span>
                                </label>
                            </div>
                            
                            <!-- تقرير الإجازات -->
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="type" id="rep_leaves" value="leaves">
                                <label class="btn btn-outline-light text-dark border-secondary w-100 p-3 h-100 d-flex flex-column align-items-center justify-content-center hover-border-gold" for="rep_leaves">
                                    <i class="fas fa-umbrella-beach fa-2x mb-2 text-info"></i>
                                    <span class="fw-bold">@(isRtl ? "سجل الإجازات" : "Leaves")</span>
                                </label>
                            </div>

                            @if (!isEmployee)
                            {
                                <!-- تقرير نسبة التفاعل -->
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="type" id="rep_interaction" value="interaction">
                                    <label class="btn btn-outline-light text-dark border-secondary w-100 p-3 h-100 d-flex flex-column align-items-center justify-content-center hover-border-gold" for="rep_interaction">
                                        <i class="fas fa-chart-line fa-2x mb-2 text-success"></i>
                                        <span class="fw-bold">@(isRtl ? "نسبة التفاعل الشهري" : "Monthly Interaction")</span>
                                    </label>
                                </div>

                                <!-- تقرير الموظفين -->
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="type" id="rep_employees" value="employees">
                                    <label class="btn btn-outline-light text-dark border-secondary w-100 p-3 h-100 d-flex flex-column align-items-center justify-content-center hover-border-gold" for="rep_employees">
                                        <i class="fas fa-users fa-2x mb-2 text-secondary"></i>
                                        <span class="fw-bold">@(isRtl ? "بيانات الموظفين" : "Employees")</span>
                                    </label>
                                </div>

                                <!-- تقرير الاشتراكات -->
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="type" id="rep_subscriptions" value="subscriptions">
                                    <label class="btn btn-outline-light text-dark border-secondary w-100 p-3 h-100 d-flex flex-column align-items-center justify-content-center hover-border-gold" for="rep_subscriptions">
                                        <i class="fas fa-file-invoice-dollar fa-2x mb-2 text-danger"></i>
                                        <span class="fw-bold">@(isRtl ? "الاشتراكات" : "Subscriptions")</span>
                                    </label>
                                </div>
                            }
                        </div>

                        <hr class="my-4 opacity-10">

                        <!-- 2. الفلاتر -->
                        <div class="row g-3">
                            @if (!isEmployee)
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">@(isRtl ? "الشركة / الفرع" : "Company / Branch")</label>
                                    <select name="companyId" id="companySelect" class="form-select bg-light" asp-items="ViewBag.Companies" onchange="loadEmployees(this.value)">
                                        <option value="">@(isRtl ? "-- الكل --" : "-- All --")</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">@(isRtl ? "تخصيص موظف محدد" : "Specific Employee")</label>
                                    <select name="employeeId" id="employeeSelect" class="form-select bg-light" asp-items="ViewBag.Employees">
                                        <option value="">@(isRtl ? "-- الكل (جميع الموظفين) --" : "-- All Employees --")</option>
                                    </select>
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">@(isRtl ? "من تاريخ / شهر التفاعل" : "From Date / Month")</label>
                                <input type="date" name="from" id="fromDate" class="form-control bg-light" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">@(isRtl ? "إلى تاريخ" : "To Date")</label>
                                <input type="date" name="to" class="form-control bg-light" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                        </div>

                        <!-- 3. زر التنفيذ -->
                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-gold bg-dark text-gold fw-bold py-3 rounded-pill shadow-lg hover-scale">
                                <i class="fas fa-print me-2"></i> @(isRtl ? "استخراج التقرير" : "Generate Report")
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-check:checked + .btn {
        background-color: #fffbf0;
        border-color: #D4AF37 !important;
        box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.3);
    }
</style>

@section Scripts {
    <script>
        function loadEmployees(companyId) {
            var empSelect = document.getElementById("employeeSelect");
            var defaultText = '@(isRtl ? "-- الكل (جميع الموظفين) --" : "-- All Employees --")';
            empSelect.innerHTML = "<option>جار التحميل...</option>";
            if (!companyId) { empSelect.innerHTML = "<option value=''>" + defaultText + "</option>"; return; }
            fetch('/Attendance/GetEmployeesByCompany?companyId=' + companyId)
                .then(res => res.json())
                .then(data => {
                    empSelect.innerHTML = "<option value=''>" + defaultText + "</option>";
                    data.forEach(item => {
                        var opt = document.createElement("option");
                        opt.value = item.id;
                        opt.text = item.name;
                        empSelect.appendChild(opt);
                    });
                }).catch(err => { empSelect.innerHTML = "<option value=''>" + defaultText + "</option>"; });
        }

        // دالة ترحيل التفاعل الشهري للمنصة
        function syncMonthlyTeleworks() {
            var compId = document.getElementById("companySelect") ? document.getElementById("companySelect").value : '';
            var monthStr = document.getElementById("fromDate").value; 
            
            if(confirm('هل أنت متأكد من إرسال سجلات التفاعل الشهري للمنصة لهذا الشهر؟')) {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                fetch('/Reports/SyncMonthlyInteraction?companyId=' + compId + '&dateStr=' + monthStr, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                }).then(res => res.json()).then(data => {
                    alert(data.message);
                });
            }
        }
    </script>
}